<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33888888">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sq_surface_alt" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/sq_stroke" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>

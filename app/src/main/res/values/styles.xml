<resources>
    <style name="SqH1">
        <item name="android:textColor">@color/sq_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SqSection">
        <item name="android:textColor">@color/sq_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SqBody">
        <item name="android:textColor">@color/sq_text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="SqCaption">
        <item name="android:textColor">@color/sq_text_dim</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="SqBtn">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
    </style>
    <style name="SqBtnGhost" parent="SqBtn">
        <item name="android:textColor">@color/sq_text</item>
        <item name="android:background">@drawable/bg_btn_ghost</item>
    </style>
</resources>
